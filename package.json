{
  "name": "clearout",
  "version": "1.0.0",
  "description": "Clearout - a modern program uninstaller for Windows that also finds leftover files",
  "main": "src/main.js",
  "author": "Clearout",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.clearout.desktop",
    "productName": "Clearout",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "artifactName": "Clearout-Setup-${version}.exe"
    }
  }
}
